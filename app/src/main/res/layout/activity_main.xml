<!--
    The frame of the app: [fragment container] + [fixed bottom navigation bar].
    The screens themselves are fragments (fragment_home.xml, fragment_stats.xml, ...).
 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" android:id="@+id/main" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical" tools:context=".MainActivity">
    <!--  The current tab's fragment goes here. 0dp + weight=1 = "take all remaining space"  -->
    <androidx.fragment.app.FragmentContainerView android:id="@+id/fragmentContainer" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
    <!--  ===== Bottom navigation bar (items come from res/menu/bottom_nav.xml) =====  -->
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottomNav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" app:itemActiveIndicatorStyle="@style/AppActiveIndicator" app:itemIconTint="@color/bottom_nav_color" app:itemTextColor="@color/bottom_nav_color" app:labelVisibilityMode="labeled" app:menu="@menu/bottom_nav"/>
</LinearLayout>