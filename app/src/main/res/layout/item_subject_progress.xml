<!--  One row of "Materii active" on Home. Filled from HomeFragment.  -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools" style="@style/AppCard" android:layout_marginTop="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="16dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_square" android:importantForAccessibility="no" android:padding="12dp" android:src="@drawable/ic_subjects" app:tint="@color/primary"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/txtSubjectName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" tools:text="Algoritmi · Sortare și căutare"/>
            <TextView android:id="@+id/txtSubjectSub" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/text_secondary" android:textSize="14sp" tools:text="8 întrebări în rotație"/>
        </LinearLayout>
        <TextView android:id="@+id/txtSubjectPercent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold" tools:text="62%"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>