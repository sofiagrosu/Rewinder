<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome (themed) icon, Android 13+: a counter-clockwise circular arrow ("go back, review")
    with a rewind symbol in the middle. Everything sits inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- circular arrow: 310° arc, drawn counter-clockwise -->
    <path
        android:pathData="M31.45,45.79 A24,24 0 1,0 45.79,31.45"
        android:strokeWidth="6"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />

    <!-- arrowhead -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M38.6,34.1 L50.6,38.6 L45.0,23.2 Z" />

    <!-- rewind symbol (two triangles pointing left) -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M43,54 L54,46 L54,62 Z M53,54 L64,46 L64,62 Z" />
</vector>
